{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.7"
  },
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "my-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "agents"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tab-bar",
          "type": "row",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "content": {
                "mod": "tabs"
              },
              "window_drag": true
            },
            {
              "id": "jira-tabbar",
              "type": "block",
              "size": {
                "px": 72
              },
              "window_drag": true,
              "content": {
                "mod": "panel-button",
                "props": {
                  "panel": "jira",
                  "label": "Jira",
                  "icon": "mods/mission-control-jira/assets/jira.svg"
                }
              }
            },
            {
              "id": "gitlab-tabbar",
              "type": "block",
              "size": {
                "px": 84
              },
              "window_drag": true,
              "content": {
                "mod": "panel-button",
                "props": {
                  "panel": "gitlab",
                  "label": "GitLab",
                  "icon": "mods/mission-control-gitlab/assets/gitlab.svg"
                }
              }
            },
            {
              "id": "issues-button",
              "type": "block",
              "size": {
                "px": 88
              },
              "window_drag": true,
              "content": {
                "mod": "panel-button",
                "props": {
                  "panel": "issues",
                  "label": "GitHub",
                  "icon": "mods/panel-button/icons/github.svg"
                }
              }
            },
            {
              "id": "git-button",
              "type": "block",
              "size": {
                "px": 64
              },
              "window_drag": true,
              "content": {
                "mod": "panel-button",
                "props": {
                  "panel": "git",
                  "label": "Git",
                  "icon": "mods/panel-button/icons/issue.svg"
                }
              }
            },
            {
              "id": "checklist-button",
              "type": "block",
              "size": {
                "px": 100
              },
              "window_drag": true,
              "content": {
                "mod": "checklist",
                "props": {
                  "view": "button"
                }
              }
            }
          ],
          "size": {
            "px": 42
          },
          "resizable": false
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    },
                    {
                      "id": "issues",
                      "type": "block",
                      "content": {
                        "mod": "issues"
                      }
                    },
                    {
                      "id": "jira",
                      "type": "block",
                      "content": {
                        "mod": "mission-control-jira"
                      }
                    },
                    {
                      "id": "gitlab",
                      "type": "block",
                      "content": {
                        "mod": "mission-control-gitlab"
                      }
                    },
                    {
                      "id": "checklist",
                      "type": "block",
                      "content": {
                        "mod": "checklist"
                      }
                    },
                    {
                      "id": "git",
                      "type": "block",
                      "content": {
                        "mod": "Git",
                        "props": {
                          "dock": {
                            "panel": "panel",
                            "stack": "panel-body",
                            "child": "git"
                          }
                        }
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "status-row",
          "type": "row",
          "children": [
            {
              "id": "session-bar",
              "type": "block",
              "content": {
                "mod": "session-bar"
              }
            },
            {
              "id": "usage-statusbar",
              "type": "block",
              "content": {
                "mod": "usage"
              },
              "size": {
                "px": 300
              }
            }
          ],
          "size": {
            "px": 28
          },
          "resizable": false
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
